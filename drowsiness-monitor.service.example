[Unit]
Description=Driver Drowsiness Monitor - Industrial Kiosk
After=network.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=%h/driver-drowsiness-monitor-rpi4
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=%h/driver-drowsiness-monitor-rpi4/.venv/bin/python run_kiosk.py
Restart=always
RestartSec=3
StandardOutput=append:%h/driver-drowsiness-monitor-rpi4/kiosk.log
StandardError=append:%h/driver-drowsiness-monitor-rpi4/kiosk.log

[Install]
WantedBy=multi-user.target
